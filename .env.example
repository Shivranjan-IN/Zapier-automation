# Copy to .env and fill in. Nothing here is committed — .env is gitignored.
# docker-compose.yml reads POSTGRES_PASSWORD / JWT_SECRET / SMTP_* at startup.

# ---------- Local Postgres (docker-compose only) ----------
POSTGRES_PASSWORD=postgres

# ---------- Auth ----------
# primary-backend signs JWTs. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# ---------- CORS ----------
# Comma-separated list of allowed browser origins (your Vercel URL in prod).
# Leave blank in local dev to allow any origin.
# e.g. CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# ---------- Database (only needed when running a service outside compose) ----------
# Compose builds this for you from the db service. For Supabase in production,
# use the Session pooler URL from your Supabase project settings.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# ---------- worker — Gmail SMTP for REAL email delivery ----------
# Create an App Password: myaccount.google.com -> App passwords (2FA required).
# Leave blank to run email in simulated mode (no real mail is sent).
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=yourgmail@gmail.com

# ---------- Ports (Render/Vercel inject these; only set for local runs) ----------
# backend defaults to 3001, hooks to 3002, worker to 3003.
# PORT=
